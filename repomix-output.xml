.gfLightbox {
    position: fixed;
    inset: 0;
    z-index: 1600;
    display: grid;
    place-items: center;
    padding: 16px;
    background: color-mix(in srgb, black 85%, transparent);

    &[hidden] {
        display: none;
    }
}

.gfLightbox__backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
}

.gfLightbox__panel {
    position: relative;
    width: min(920px, 96vw);
    height: min(78vh, 680px);
    display: grid;
