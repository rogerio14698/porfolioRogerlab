        "jsCode": "const items = $input.all();\n\n// Configuración del perfil\nconst miPerfil = {\n  stackPrincipal: ['php', 'laravel', 'javascript', 'js', 'mysql', 'docker', 'html', 'css', 'sass', 'scss', 'git', 'github'],\n  tecnologiasSecundarias: ['python', 'typescript', 'java', 'sql', 'postgres', 'mariadb', 'nginx', 'apache', 'aws', 'ec2', 'postman', 'node'],\n  rolesBusqueda: ['desarrollador', 'developer', 'full stack', 'fullstack', 'backend', 'web', 'junior', 'daw'],\n  palabrasPenalizadas: ['senior', 'sr', 'lead', 'architect', 'arquitecto', 'c#', '.net']\n};\n\n// Regex para detectar menciones de 3 o más años de experiencia\n// Captura patrones como: \"4 años\", \"3+ años\", \"3 a 5 años de experiencia\", \"mínimo 4 años\", etc.\nconst regexExcesoExperiencia = /(?:[3-9]|\\d{2,})\\s*(?:\\+|\\s*a\\s*\\d+)?\\s*(?:años|año)\\s*(?:de)?\\s*(?:experiencia)?/i;\n\nconst ofertasEvaluadas = [];\n\nfor (const item of items) {\n  const data = item.json;\n  const textoPuesto = (data.puesto || '').toLowerCase();\n  const textoDescripcion = (data.descripcion || '').toLowerCase();\n  const textoCompleto = `${textoPuesto} ${textoDescripcion}`;\n\n  // 1. FILTRO DE DESCARTE DIRECTO: Si exige 3 o más años de experiencia, se descarta inmediatamente\n  if (regexExcesoExperiencia.test(textoCompleto)) {\n    continue; // Salta a la siguiente oferta sin incluir esta\n  }\n\n  let score = 0;\n\n  // 2. Coincidencia en el título del puesto (+15 por rol relevante)\n  miPerfil.rolesBusqueda.forEach(rol => {\n    if (textoPuesto.includes(rol)) score += 15;\n  });\n\n  // 3. Coincidencia del Stack Principal (+10 puntos por tecnología)\n  miPerfil.stackPrincipal.forEach(tech => {\n    if (textoCompleto.includes(tech)) score += 10;\n  });\n\n  // 4. Coincidencia de Tecnologías Secundarias (+5 puntos)\n  miPerfil.tecnologiasSecundarias.forEach(tech => {\n    if (textoCompleto.includes(tech)) score += 5;\n  });\n\n  // 5. Penalización por títulos/roles Senior (-20 puntos)\n  miPerfil.palabrasPenalizadas.forEach(word => {\n    if (textoCompleto.includes(word)) score -= 20;\n  });\n\n  ofertasEvaluadas.push({\n    json: {\n      ...data,\n      matchScore: Math.max(0, score)\n    }\n  });\n}\n\n// Ordenar de MAYOR a MENOR coincidencia\nofertasEvaluadas.sort((a, b) => b.json.matchScore - a.json.matchScore);\n\n// Retornar exactamente las mejores 50 ofertas válidas\nreturn ofertasEvaluadas.slice(0, 50);"
