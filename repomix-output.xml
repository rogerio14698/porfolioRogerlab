        "jsCode": "function limpiarTexto(texto) {\n  if (!texto) return '';\n\n  return texto\n    // Decodifica entidades HTML comunes\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\")\n    .replace(/&nbsp;/g, ' ')\n    // Convierte <li> y saltos de línea en un separador legible\n    .replace(/<li[^>]*>/gi, '• ')\n    .replace(/<\\/li>/gi, ' | ')\n    .replace(/<br\\s*\\/?>/gi, ' | ')\n    .replace(/<\\/p>/gi, ' | ')\n    // Elimina cualquier otro tag HTML restante\n    .replace(/<[^>]+>/g, ' ')\n    // Colapsa espacios múltiples y separadores duplicados\n    .replace(/\\s+/g, ' ')\n    .replace(/(\\|\\s*)+/g, ' | ')\n    .trim();\n}\n\nfunction extraerJobPosting(html) {\n  if (!html) return null;\n\n  // Busca todos los bloques ld+json (puede haber varios en la página)\n  const bloques = [...html.matchAll(/<script type=\"application\\/ld\\+json\">([\\s\\S]*?)<\\/script>/gi)];\n\n  for (const bloque of bloques) {\n    try {\n      const data = JSON.parse(bloque[1]);\n      if (data['@type'] === 'JobPosting') {\n        return data;\n      }\n    } catch (e) {\n      // Si falla el parseo (JSON cortado o malformado), continúa con el siguiente bloque\n      continue;\n    }\n  }\n  return null;\n}\n\nconst items = $input.all();\nconst resultados = [];\n\nfor (const item of items) {\n  const html = item.json.data || item.json.body || item.json.html || (typeof item.json === 'string' ? item.json : '');\n\n  const jobPosting = extraerJobPosting(html);\n\n  resultados.push({\n    json: {\n      puesto: jobPosting?.title || '',\n      empresa: jobPosting?.hiringOrganization?.name || '',\n      ubicacion: jobPosting?.jobLocation?.address?.addressLocality || '',\n      pais: jobPosting?.jobLocation?.address?.addressCountry || '',\n      descripcion: limpiarTexto(jobPosting?.description || '')\n    }\n  });\n}\n\nreturn resultados.length > 0 ? resultados : [{ json: { mensaje: \"Sin JobPosting encontrado\" } }];"
