<file path="resources/sass/global/_global.scss">
@use './variables' as v;

html {
    box-sizing: border-box;
    scrollbar-gutter: stable;
    scroll-padding-top: 6rem;
}

*, *::before, *::after {
    box-sizing: inherit;
}

body {
    --_fondo: var(--surface-page);
    --_fondoPanel: var(--surface-raised);
    --_texto: var(--text-primary);
    --_textoSoft: var(--text-secondary);
    --_textoHover: var(--text-primary);
    --_linea: var(--field-border);
    --colorBorde: var(--field-border);
    margin: 0;
    background: var(--surface-page);
    color: var(--text-primary);
    font: 400 var(--text-body) / 1.65 var(--font-body);
    overflow-wrap: anywhere;
    -webkit-font-smoothing: antialiased;
}

h1, h2, h3, h4, h5, h6, p, ul, ol {
    margin: 0;
    padding: 0;
}

h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    text-wrap: balance;
}

a {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 0.08em;
}

ul, ol { list-style: none; }
button, input, textarea, select { font: inherit; }
button, a, input, textarea { -webkit-tap-highlight-color: transparent; }
button { cursor: pointer; }
button:disabled { cursor: not-allowed; opacity: 0.65; }
img { display: block; max-width: 100%; height: auto; }
::selection { background: var(--action-bg); color: var(--action-text); }
input, textarea { caret-color: var(--text-primary); }

:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
}

* {
    scrollbar-width: thin;
    scrollbar-color: var(--field-border) transparent;
}

#mainShaderBg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    opacity: 0.1;
    mix-blend-mode: screen;
}

body[data-theme="light"] #mainShaderBg {
    opacity: 0.06;
    mix-blend-mode: multiply;
}

.mainContent {
    position: relative;
    z-index: 1;
    max-width: 1480px;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--page-gutter);
}

.contenedor { width: 100%; }

@media (prefers-reduced-motion: no-preference) {
    .is-revealed {
        animation: dossier-enter var(--duration-enter) var(--ease-out) both;
    }
}

@keyframes dossier-enter {
    from { opacity: 0.65; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
}

@media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
}
</file>

<file path="resources/sass/src/_darkModeContainer.scss">
.asideLeft {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;

    button {
        gap: var(--space-2);
        min-width: 44px;
        min-height: 44px;
        padding: var(--space-2);
        flex-shrink: 0;

        &:hover { text-decoration: none; background: var(--surface-raised); }
        &.active:hover { background: var(--action-bg); }
        &:active:not(:disabled) { transform: translateY(1px); }
    }

    .preferenceIcon {
        display: block;
        width: 22px;
        height: 22px;
        flex-shrink: 0;
    }

    .preferenceLabel:not([hidden]) {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    [hidden] { display: none; }

    #backgroundMotionToggle {
        background: transparent;
        color: var(--text-primary);

        &:hover:not(:disabled) { background: var(--surface-raised); }
        .motionIcon--pause { display: none; }

        &[aria-pressed="true"] {
            .motionIcon--play { display: none; }
            .motionIcon--pause { display: block; }
        }
    }
}

@media (min-width: 48rem) {
    .asideLeft {
        button { padding-inline: var(--space-3); }

    }
}
