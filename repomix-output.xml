        ];
        $slides = [
            ['type' => 'project', 'id' => $first->id, 'position' => 3, 'visible' => 1],
            ['type' => 'blog', 'id' => $article->id, 'position' => 1, 'visible' => 1],
            ['type' => 'project', 'id' => $second->id, 'position' => 2, 'visible' => 1],
            ['type' => 'blog', 'id' => $hidden->id, 'position' => 4, 'visible' => 0],
