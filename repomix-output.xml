         color: var(--text-secondary);\n        }\n\n        &__stack { font-weight: 600; }\n        .description p { max-width: 65ch; }\n        .description p + p { margin-top: var(--space-4); }\n        &__actions { align-self: end; }\n        &__actions a:not(:first-child) { background: var(--surface-page); }\n\n        .galeria {\n            display: grid;\n            grid-template-columns: repeat(3, minmax(0, 1fr));\n            gap: var(--space-2);\n            align-content: start;\n            min-width: 0;\n\n            &__item {\n                display: block;\n                min-width: 0;\n                min-height: 44px;\n                aspect-ratio: 4 / 3;\n                border: 0;\n                padding: 0;\n                background: var(--surface-media);\n                overflow: hidden;\n                &[hidden] { display: none; }\n\n                img {\n                    width: 100%;\n                    height: 100%;\n                    object-fit: cover;\n                    transition: transform var(--duration-enter) var(--ease-out);\n                }\n                &:hover img, &:focus-visible img { transform: scale(1.04); }\n            }\n\n            &--n8n {\n                grid-template-columns: 1fr;\n                .galeria__item {\n                    aspect-ratio: 16 / 10;\n                    img { object-fit: contain; }\n                }\n            }\n\n            &__nav { grid-column: 1 / -1; }\n        }\n    }\n}\n\n.gfLightbox {\n    position: fixed;\n    inset: 0;\n    z-index: 1600;\n    display: grid;\n    place-items: center;\n    padding: var(--space-4);\n    background: rgb(0 0 0 / 85%);\n    &[hidden] { display: none; }\n}\n\n.gfLightbox__backdrop { position: absolute; inset: 0; border: 0; background: transparent; }\n\n.gfLightbox__panel {\n    position: relative;\n    display: grid;\n    grid-template-rows: minmax(0, 1fr) auto;\n    gap: var(--space-4);\n    width: min(1120px, 100%);\n    heig