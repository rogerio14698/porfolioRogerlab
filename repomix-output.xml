            $path = 'images/'.$record->id.'.jpg';
            Storage::disk('blog')->put($path, 'image');
            $record->images()->create(['path' => $path, 'alt' => ['es' => 'a', 'en' => 'a', 'pt' => 'a'], 'position' => 0]);
