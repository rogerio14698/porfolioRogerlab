r(--colorBorde) #{v.$opacidadScrollbarHover}, transparent);\n}\n\n#mainShaderBg {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    z-index: 0;\n    pointer-events: none;\n}\n\n.mainContent {\n    position: relative;\n    z-index: 1;\n}\n\n.contenedor {\n    margin: 0 auto;\n    width: #{v.$anchoContenedor};\n}\n","\n\n@use './variables' as v;\n@use './tools' as t;\n\n// Base visual compartida por las acciones interactivas del portfolio.\n.heroeActions a,\n.project-card__actions a,\n.galeria__navBtn,\n.gfLightbox__btn,\n.practicasModalTrigger,\n.contactSubmitRow button {\n\tdisplay: inline-flex;\n\talign-items: center;\n\tjustify-content: center;\n\tmin-height: 34px;\n\tpadding: 6px 10px;\n\tborder: 1px solid color-mix(in srgb, var(--colorBorde) 75%, transparent);\n\tbackground-color: transparent;\n\tcolor: var(--_texto);\n\tcursor: pointer;\n\tfont-family: v.$fuenteTexto;\n\tfont-size: t.fluido(0.78rem, 0.95rem);\n\tline-height: 1.2;\n\ttext-decoration: none;\n\ttransition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;\n\n\t&:hover {\n\t\tbackground-color: var(--colorBorde);\n\t\tcolor: var(--_fondoPanel);\n\t}\n\n\t&:active {\n\t\ttransform: translateY(1px);\n\t}\n\n\t&:focus-visible {\n\t\toutline: 2px solid var(--_texto);\n\t\toutline-offset: 2px;\n\t}\n}\n\n.galeria__nav {\n\tdisplay: flex;\n\tjustify-content: space-between;\n\talign-items: center;\n\tgap: 8px;\n\twidth: 100%;\n\tmargin-top: 8px;\n}\n\n.galeria__navBtn {\n\tflex: 1;\n\tmin-width: 0;\n}\n\n.gfLightbox__btn {\n\tmin-width: 40px;\n}\n\n.practicasModalTrigger {\n\tmin-height: 36px;\n\tpadding: 6px 12px;\n}\n\n.contactSubmitRow button {\n\tmin-width: min(260px, 100%);\n\tpadding: 10px 16px;\n\tfont-size: v.$tamanoEnlaces;\n}\n\n.practicasModal__close {\n\tposition: absolute;\n\ttop: 16px;\n\tright: 16px;\n\tdisplay: inline-flex;\n\talign-items: center;\n\tjustify-content: center;\n\tmin-width: 36px;\n\theight: 36px;\n\tpadding: 0 10px;\n\tborder: 1px solid var(--colorBorde);\n\tborder-radius: 999px;\n\tbackground: color-mix(in srgb, var(--_fondoPanel) 90%, transparent);\n\tcolor: var(--_texto);\n\tcursor: pointer;\n\n\t&:focus-visible {\n\t\toutline: 2px solid var(--_texto);\n\t\toutline-offset: 2px;\n\t}\n}\n\n.asideLeft button {\n\tborder: 0;\n\tbackground: transparent;\n\tcolor: var(--_texto);\n\tcursor: pointer;\n\tfont-family: v.$fuenteTexto;\n\ttransition: color 0.5s ease, opacity 0.3s ease;\n\n\t&:focus-visible {\n\t\toutline: 2px solid var(--_texto);\n\t\toutline-offset: -2px;\n\t}\n}\n\n.btnIdioma {\n\tdisplay: inline-flex;\n\talign-items: center;\n\tjustify-content: center;\n\tmin-width: t.fluido(30px, 40px);\n\tpadding: 4px 8px;\n\tborder: 3px solid var(--colorBorde);\n\tbackground-color: transparent;\n\tcolor: var(--_texto);\n\tcursor: pointer;\n\tfont-family: v.$fuenteTexto;\n\tfont-size: 0.9rem;\n\ttransition: background-color 0.3s ease, color 0.3s ease;\n\n\t&.is-active,\n\t&:hover {\n\t\tbackground-color: var(--colorBorde);\n\t\tcolor: var(--_fondoPanel);\n\t}\n\n\t&:focus-visible {\n\t\toutline: 2px solid var(--_texto);\n\t\toutline-offset: 2px;\n\t}\n}\n\n","// --- Colores Fondo ---\n$colorModoDarkFondo: #222;\n$colorModoLightFondo: #ece8df;\n\n// --- Fondos de panel ---\n$colorFondoPanelDark: rgba(34, 34, 34, .9);\n$colorFondoPanelLight: hsla(0, 0%, 100%, .88);\n\n// --- Líneas ---\n$colorLineaLight: #999;\n$colorLineaDark: #fff;\n\n// --- Botones ---\n$colorbtnDark: #333;\n$colorbtnLight: #fff;\n$btnLight: #999;\n$btnDark: #222;\n\n// --- Textos y Bordes ---\n$colorTextoLight: #dddddd;\n$colorTextoDark: #1f1f1f;\n$colorBorde: #999999;\n$colorBordeLight: #444;\n$opacidadScrollbar: 45%;\n$opacidadScrollbarHover: $opacidadScrollbar + 20%;\n\n// --- Tamaños ---\n$anchoContenedor: 90%;\n\n// En Sass puedes usar variables dentro de otras variables directamente\n$borde: 2px solid $colorBorde; \n\n// --- Fuentes (Tipografía) ---\n// Nota: Corregido el 'sans-serif3' que tenías por 'sans-serif'\n$fuenteTitulo: 'Saira Stencil', sans-serif; \n$grosorTitulo: 100;\n$estiloTitulo: normal;\n\n$fuenteTexto: 'Kode Mono', monospace;\n$grosorTexto: 400;\n$estiloTexto: normal;\n\n// --- Media Queries: Tamaños (1370px) ---\n$tamanoTituloDesktopXL: 2.6rem;\n$tamanoEnlacesDesktopXL: 1.2rem;\n$tamanoTextoDesktopXL: .8rem;\n\n// --- Tamaños Base ---\n$tamanoTitulo: $tamanoTituloDesktopXL;\n$tamanoEnlaces: $tamanoEnlacesDesktopXL;\n$tamanoTexto: $tamanoTextoDesktopXL;\n\n// --- Media Queries: Tamaños (576px) ---\n$tamanoTituloMovileXS: 2rem;\n$tamanoTextoMovileXS: 0.9rem;\n$tamanoEnlaceMovileXS: 0.9rem;\n\n// --- Media Queries: Tamaños (768px) ---\n$tamanoTitulotoMovil: 2.2rem;\n$tamanoTextoMovil: 1.1rem; ","@use '../global/variables' as v;\n@use '../global/tools' as t;\n\n.titulo {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: flex-start;\n    height: 10rem;\n    background-color: var(--_fondoPanel);\n    transition: background-color 0.5s ease;\n    width: 100%;\n    padding: clamp(0.65rem, 0.4rem + 0.8vw, 1rem) clamp(0.9rem, 0.65rem + 0.8vw, 1.45rem);\n    border: 1px solid v.$colorBorde;\n    border-bottom: none;\n    padding-bottom: 20px;\n\n    h1 {\n        font-family: v.$fuenteTitulo;\n        font-weight: v.$grosorTitulo;\n        font-style: v.$estiloTitulo;\n        color: var(--_texto);\n        transition: color 0.5s ease;\n        // ahora el tamaño del título se ajusta automáticamente entre 20px y 50px según el ancho del viewport entre 400px y 1220px\n        //font-size: t.fluido(20px, 50px, 400px, 1220px);\n        font-size: clamp(2rem, 4.4vw, 4.4rem);\n        //Tamaño fijo para moviles, para que no quede enano\n         @media (max-width: 480px) {\n        font-size: 11vw; // Le damos más fuerza en móviles para que no quede enano\n        }\n        @media (max-width: 1400px) {\n        font-size: 9vw; // Le damos más fuerza en móviles para que no quede enano\n        }\n    }\n\n\n    p {\n        align-self: stretch;\n        margin-left: 0;\n        padding-left: 2ch;\n        display: flex;\n        align-items: center;\n        gap: t.fluido(0.5rem, 1.2rem);\n        font-family: v.$fuenteTexto;\n        font-weight: v.$grosorTexto;\n        font-style: v.$estiloTexto;\n        font-size: clamp(0.78rem, 0.7rem + 0.45vw, 1.05rem);\n        letter-spacing: 0.12em;\n        text-transform: uppercase;\n        color: var(--_texto);\n        transition: color 0.5s ease;\n\n        &::before {\n            content: \"//\";\n            opacity: 0.65;\n            margin-right: 0.35rem;\n        }\n        \n\n        &::after {\n            content: \"\";\n            flex: 1;\n            height: 1px;\n            margin-left: 2ch;\n            margin-right: 2ch;\n            background-color: var(--_linea);\n            transition: background-color 0.5s ease;\n            transform-origin: left center;\n            animation: subtitleLineReveal 5000ms ease-out forwards,\n                       subtitleLineFlow 3.2s ease-in-out 2000ms infinite;\n        }\n    }\n}\n\n@keyframes subtitleLineReveal {\n    from { transform: scaleX(0); opacity: 0; }\n    to { transform: scaleX(1); opacity: 1; }\n}\n@keyframes subtitleLineFlow {\n    0%, 100% { opacity: 0.5; }\n    50% { opacity: 1; }\n}","@use \"../global/variables\" as v;\n@use \"../global/tools\" as t;\n\n.nav {\n    display: flex;\n    flex-direction: row;\n    background-color: var(--_fondoPanel);\n    border: 1px solid var(--colorBorde);\n    align-items: flex-start;\n    font-family: v.$fuenteTexto;\n    @media (max-width: 1200px) {\n        font-size: t.fluido(0.8rem, 1rem);\n    }\n    font-size: 1rem;\n    trasition: background-color 0.5s ease;\n\n    .nav-toggle {\n        display: none;\n        align-items: center;\n        flex-direction: column;\n        justify-content: center;\n        border: none;\n        background: transparent;\n        padding: 0.75rem;\n        margin-right: 1rem;\n        cursor: pointer;\n\n        span {\n            display: block;\n            width: 26px;\n            height: 3px;\n            margin: 4px 0;\n            background-color: var(--_texto);\n            transition: transform 0.3s ease, opacity 0.3s ease, width 0.3s ease;\n        }\n    }\n    //AQui se gestiona la animacion del menu una vez desplegado.\n    &.is-open .nav-toggle span:nth-child(1) {\n        transform: translateY(4px) translate(5px, 5px) rotate(45deg);\n        width: 40px;\n    }\n\n    &.is-open .nav-toggle span:nth-child(2) {\n        opacity: 0;\n    }\n\n    &.is-open .nav-toggle span:nth-child(3) {\n        transform: translateY(-4px) translate(5px, -5px) rotate(-45deg);\n        width: 40px;\n    }\n\n    ul {\n        display: flex;\n        justify-content: space-around;\n        align-items: center;\n        flex-direction: row;\n        margin-left: 10px;\n    }\n    li {\n     padding: 8px 12px;\n    }\n    a {\n        color: var(--_texto);\n        transition: color 0.2s ease;\n    }\n    a:hover {\n        color: var(--_textoHover);\n        transition: color 0.2s ease;\n    }\n    a::after {\n        content: \"\";\n        position: absolute;\n        left: 0;\n        bottom: 0;\n        width: 100%;\n        height: 1px;\n        background-color: #999;\n        transform: scaleX(0);\n        transform-origin: left center;\n        transition: transform 0.8s ease;\n    }\n    a:hover::after,\n    a:focus-visible::after {\n        transform: scaleX(0.9);\n    }\n\n    .sectionLanguageBar {\n    display: flex;\n    justify-content: center;\n    margin-left: auto;\n    padding:t.fluido(4px, 8px);\n    //Aqui tengo que poner una mq para que en version movil aparezca debajo.\n    //border-bottom: 1px solid var(--colorBorde);\n\n    .selectIdioma {\n        display: flex;\n        gap: 5px;\n    }\n}\n}\n\n//media query para un menu de version movil del nav\n\n.nav {\n    @media (max-width: 768px) {\n        flex-direction: column;\n        justify-content: flex-start;\n        align-items: flex-start;\n\n        ul {\n            flex-direction: column;\n            align-items: flex-start;\n            width: 100%;\n            gap: 10px;\n            margin-left: 0;\n            padding: 10px;\n        }\n        .sectionLanguageBar {\n            margin-left: 0;\n            width: 100%;\n            justify-content: flex-start;\n            padding: 10px;\n        }\n\n        .nav-toggle {\n            display: flex;\n        }\n\n        ul {\n            display: none;\n            width: 100%;\n        }\n\n        &.is-open ul {\n            display: flex;\n        }\n\n    }\n}\n","@use '../global/variables' as v;\n@use '../global/tools' as t;\n\n.contenidoMain {\n    display: flex;\n    flex-direction: column;\n    justify-content: flex-start;\n    align-items: flex-start;\n    min-height: 100vh;\n    width: calc(90% - var(--aside-space));\n    margin-left: var(--aside-space);\n    margin-bottom: auto;\n    border: 1px solid var(--colorBorde);\n    border-top: none;\n    position: relative;\n    overflow: visible;\n    background-color: var(--_fondoPanel);\n    transition: background-color 0.5s ease;\n\n    @media (max-width: 768px) {\n        min-height: auto;\n        width: 100%;\n        margin-left: 0;\n        padding: 0;\n    }\n}\n\n#dynamic-section {\n    width: 100%;\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    min-height: 0;\n}\n\n.asideLeft {\n    --aside-width: clamp(30px, 4vw, 50px);\n    --aside-height: 500px;\n    position: absolute;\n    top: 50%;\n    left: calc(-1 * (var(--aside-width) + 10px));\n    transform: translateY(-50%);\n    padding: 4px;\n    width: var(--aside-width);\n    height: var(--aside-height);\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 6px;\n    overflow: hidden;\n    background-color: var(--_fondo);\n    transition: background-color 0.5s ease;\n    font-family: v.$fuenteTexto;\n\n    button {\n        border: none;\n        writing-mode: vertical-rl;\n        width: 100%;\n        background: none;\n        color: var(--_texto);\n        cursor: pointer;\n        padding: 2px;\n        font-size: clamp(10px, 3vw, 15px);\n        opacity: 0.45;\n        transition: color 0.5s ease, opacity 0.3s ease;\n        display: flex;\n        flex-direction: row;\n        align-items: center;\n        justify-content: center;\n        flex: 1 1 0;\n        min-height: 0;\n    }\n}","@use \"../global/variables\" as v;\n\n.asideLeft {\n    $aside-width: clamp(30px, 4vw, 50px);\n    $aside-height: 300px;\n    position: absolute;\n    top: 50%;\n    left: calc(-1 * $aside-width - 3px);\n    transform: translateY(-50%);\n    padding: 4px;\n    width: $aside-width;\n    height: $aside-height;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 6px;\n    overflow: hidden;\n    //background-color: v.$fondo;\n    transition: background-color 0.5s ease;\n    font-family: v.$fuenteTexto;\n\n    button {\n        writing-mode: vertical-rl;\n        width: 100%;\n        padding: 2px;\n        font-size: clamp(10px, 3vw, 15px);\n        opacity: 0.45;\n        display: flex;\n        flex-direction: row;\n        align-items: center;\n        justify-content: center;\n        flex: 1 1 0;\n        min-height: 0;\n    }\n    button.active {\n        opacity: 1;\n        //border-left: 2px solid v.$colorBordeLight;\n\n        span {\n            margin: 5px;\n        }\n        .figurabtnDark {\n            display: block;\n            width: 20px;\n            height: 20px;\n            background-color: v.$colorbtnDark;\n            border: none;\n        }\n        .figurabtnLight {\n            display: block;\n            width: 20px;\n            height: 20px;\n            background-color: v.$colorbtnLight;\n            border: none;\n        }\n    }\n\n    //Estilos para movil: cambia de posicio