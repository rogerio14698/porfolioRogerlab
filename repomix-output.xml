        gap: 10px;\n            h2{\n                align-self: end;\n                font-size: t.fluido(1.5rem, 2rem);\n                font-family: v.$fuenteTexto;\n                font-weight: v.$grosorTitulo;\n                color: var(--_texto);\n                text-decoration: underline double var(--colorBorde);\n            }\n            img{\n                border: 3px solid var(--colorBorde);\n                width: 100px;\n                height: auto;\n            }\n        }\n        .descripcionJuego{\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            gap: 10px;\n            p{\n                font-size: t.fluido(0.8rem, 1rem);\n                font-family: v.$fuenteTexto;\n                color: var(--_textoSoft);\n                line-height: 1.8;\n                padding: 6px 8px;\n                text-align: justify;\n                &::first-letter {\n                    font-size: 130%;\n                }\n            }\n            a{\n                display: inline-flex;\n                align-items: center;\n                justify-content: center;\n                font-size: v.$tamanoEnlaces;\n                font-family: v.$fuenteTexto;\n                padding: 6px 10px;\n                cursor: pointer;\n                border: 1px solid var(--colorBorde);\n                background-color: transparent;\n                color: var(--_texto);\n                transition:\n                    background-color 0.3s ease,\n                    color 0.3s ease;\n                width: auto;\n                min-width: 44px;\n                margin: 5px;\n            }\n        }\n    }\n}\n\n.gamesScrollHint {\n    display: none;\n}\n@media (max-width: 768px) {\n    .gamesScrollHint {\n        display: block;\n        text-align: center;\n        font-size: .8rem;\n        font-family: v.$fuenteTexto;\n        color: var(--_texto);\n        margin-top: 1rem;\n        padding: 1rem;\n        border: 1px solid var(--colorBorde);\n        background: var(--_fondoPanel);\n        \n    }\n    .gamesScrollHint::before {\n        content: \"\";\n        position: absolute;\n        top: 0;\n        left: 0;\n        width: 100%;\n        height: 100%;\n        background: var(--_fondo);\n        z-index: -1;\n    }\n}","// --- Colores Fondo ---\n$colorModoDarkFondo: #222;\n$colorModoLightFondo: #ece8df;\n\n// --- Fondos de panel ---\n$colorFondoPanelDark: rgba(34, 34, 34, .9);\n$colorFondoPanelLight: hsla(0, 0%, 100%, .88);\n\n// --- Líneas ---\n$colorLineaLight: #999;\n$colorLineaDark: #fff;\n\n// --- Botones ---\n$colorbtnDark: #333;\n$colorbtnLight: #fff;\n$btnLight: #999;\n$btnDark: #222;\n\n// --- Textos y Bordes ---\n$colorTextoLight: #dddddd;\n$colorTextoDark: #1f1f1f;\n$colorBorde: #999999;\n$colorBordeLight: #444;\n$opacidadScrollbar: 45%;\n$opacidadScrollbarHover: $opacidadScrollbar + 20%;\n\n// --- Tamaños ---\n$anchoContenedor: 90%;\n\n// En Sass puedes usar variables dentro de otras variables directamente\n$borde: 2px solid $colorBorde; \n\n// --- Fuentes (Tipografía) ---\n// Nota: Corregido el 'sans-serif3' que tenías por 'sans-serif'\n$fuenteTitulo: 'Big Shoulders', sans-serif;\n$grosorTitulo: 600;\n$estiloTitulo: normal;\n\n$fuenteTexto: 'Public Sans', sans-serif;\n$grosorTexto: 400;\n$estiloTexto: normal;\n\n// --- Media Queries: Tamaños (1370px) ---\n$tamanoTituloDesktopXL: 2.6rem;\n$tamanoEnlacesDesktopXL: 1.2rem;\n$tamanoTextoDesktopXL: 1rem;\n\n// --- Tamaños Base ---\n$tamanoTitulo: $tamanoTituloDesktopXL;\n$tamanoEnlaces: $tamanoEnlacesDesktopXL;\n$tamanoTexto: $tamanoTextoDesktopXL;\n\n// --- Media Queries: Tamaños (576px) ---\n$tamanoTituloMovileXS: 2rem;\n$tamanoTextoMovileXS: 0.9rem;\n$tamanoEnlaceMovileXS: 0.9rem;\n\n// --- Media Queries: Tamaños (768px) ---\n$tamanoTitulotoMovil: 2.2rem;\n$tamanoTextoMovil: 1.1rem; ",".seccionContact {\n    display: grid;\n    gap: var(--space-8);\n    align-items: start;\n\n    h1 { font-size: var(--text-display); }\n    form { display: grid; gap: var(--space-6); min-width: 0; }\n\n    .contactFormGrid { display: grid; gap: var(--space-6); }\n\n    .formLabel {\n        display: grid;\n        gap: var(--space-2);\n        align-content: start;\n        min-width: 0;\n\n        label { font-size: var(--text-body); font-weight: 600; }\n        input, textarea {\n            width: 100%;\n            min-width: 0;\n            min-height: 52px;\n            padding: var(--space-4);\n            border: 1px solid var(--field-border);\n            border-radius: var(--radius-control);\n            background: var(--input-bg);\n            color: var(--text-primary);\n            line-height: 1.5;\n\n            &::placeholder { color: var(--text-secondary); opacity: 1; }\n            &:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 4px; }\n            &[aria-invalid=\"true\"] { border-width: 2px; }\n        }\n\n        textarea { min-height: 220px; resize: vertical; }\n    }\n\n    .contactFormMeta, .contactAlert {\n        padding: var(--space-6);\n        background: var(--surface-raised);\n        p { font-size: var(--text-body); max-width: 65ch; }\n    }\n\n    .contactAlert--error { font-weight: 600; }\n    .contactTurnstile { min-height: 65px; max-width: 100%; }\n    .contactSubmitRow { display: flex; }\n    .contactSubmitRow button { min-width: min(240px, 100%); }\n}\n\n@media (min-width: 48rem) {\n    .seccionContact {\n        grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);\n        gap: var(--space-12);\n    }\n}\n\n@media (min-width: 64rem) {\n    .seccionContact {\n        .contactFormGrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n        .formLabel:nth-child(n + 3) { grid-column: 1 / -1; }\n    }\n}\n"]}
