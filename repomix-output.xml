      "parameters": {
        "jsCode": "// 1. Obtención de la plantilla desde el nodo de Google Docs de forma segura\nlet plantillaDocs = '';\ntry {\n  const docNode = $('Get a document').first().json;\n  plantillaDocs = docNode.content || docNode.text || docNode.body || '';\n} catch (e) {\n  plantillaDocs = 'Estimados Sres de {{EMPRESA}}:\\n\\nMe dirijo a ustedes para el puesto de {{PUESTO}}.';\n}\n\n// Función auxiliar para reemplazar placeholders\nfunction generarCoverLetter(plantilla, empresa, puesto) {\n  if (!plantilla) return '';\n  return plantilla\n    .replace(/\\{\\{EMPRESA\\}\\}/g, empresa || 'la empresa')\n    .replace(/\\{\\{PUESTO\\}\\}/g, puesto || 'Desarrollador Web');\n}\n\n// Función para extraer el apartado \"Acerca del empleo\" y devolverlo como lista en una sola celda\nfunction extraerAcercaDelEmpleo(html) {\n  if (!html) return '';\n\n  // Busca el bloque que suele contener la descripción tras el título \"Acerca del empleo\"\n  const bloqueMatch = html.match(/Acerca del empleo[\\s\\S]*?(<ul[\\s\\S]*?<\\/ul>|<div[^>]*show-more-less-html__markup[^>]*>[\\s\\S]*?<\\/div>)/i);\n  if (!bloqueMatch) return '';\n\n  const bloqueHtml = bloqueMatch[1];\n\n  // Extrae los <li> si existen\n  const items = [...bloqueHtml.matchAll(/<li[^>]*>([\\s\\S]*?)<\\/li>/gi)]\n    .map(m => m[1].replace(/<[^>]+>/g, '').trim())\n    .filter(Boolean);\n\n  if (items.length > 0) {\n    // Lista en una sola celda, separada por \" • \"\n    return items.map(i => `• ${i}`).join(' | ');\n  }\n\n  // Si no hay <li>, limpia el HTML y devuelve el texto plano\n  const textoPlano = bloqueHtml.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n  return textoPlano;\n}\n\nconst items = $input.all();\nconst resultados = [];\n\nfor (const item of items) {\n  const data = item.json;\n\n  // 1. Detección exhaustiva de HTML / Body\n  const html = data.data || data.body || data.html || (typeof data === 'string' ? data : '');\n\n  // 2. Detección exhaustiva de URL y Portal\n  const rawUrl = data.url || data.headers?.referer || data.headers?.location || '';\n  let portal = data.portal;\n\n  if (!portal) {\n    if (rawUrl.includes('linkedin.com') || html.includes('linkedin.com')) portal = 'LinkedIn';\n  }\n\n  // --- LINKEDIN ---\n  if (portal === 'LinkedIn') {\n    const jsonLdMatch = html.match(/<script type=\"application\\/ld\\+json\">([\\s\\S]*?)<\\/script>/i);\n    let jsonLdJobs = [];\n\n    if (jsonLdMatch && jsonLdMatch[1]) {\n      try {\n        const parsedData = JSON.parse(jsonLdMatch[1]);\n        if (parsedData.itemListElement && Array.isArray(parsedData.itemListElement)) {\n          jsonLdJobs = parsedData.itemListElement.map(job => ({\n            puesto: job.name,\n            empresa: job.disambiguatingDescription || 'Empresa No Especificada',\n            ubicacion: job.description || 'España',\n            enlace: job.url\n          }));\n        }\n      } catch (e) {}\n    }\n\n    const matches = html.match(/<div class=\"[^\"]*base-card[^\"]*\"[\\s\\S]*?<\\/li>/g) || [];\n    const htmlJobs = [];\n    matches.forEach(card => {\n      const titleMatch = card.match(/<h3 class=\"[^\"]*base-search-card__title[^\"]*\">([\\s\\S]*?)<\\/h3>/);\n      const linkMatch = card.match(/<a class=\"[^\"]*base-card__full-link[^\"]*\" href=\"([^\"?]+)/);\n      const companyMatch = card.match(/<h4 class=\"[^\"]*base-search-card__subtitle[^\"]*\">([\\s\\S]*?)<\\/h4>/);\n\n      if (titleMatch && linkMatch) {\n        htmlJobs.push({\n          puesto: titleMatch[1].replace(/<[^>]+>/g, '').trim(),\n          empresa: companyMatch ? companyMatch[1].replace(/<[^>]+>/g, '').trim() : 'Empresa No Especificada',\n          ubicacion: 'España',\n          enlace: linkMatch[1].trim()\n        });\n      }\n    });\n\n    const finalJobs = jsonLdJobs.length > 0 ? jsonLdJobs : htmlJobs;\n\n    finalJobs.forEach(job => {\n      resultados.push({\n        json: {\n          portal: 'LinkedIn',\n          puesto: job.puesto,\n          empresa: job.empresa,\n          ubicacion: job.ubicacion,\n          enlace: job.enlace,\n          descripcion: extraerAcercaDelEmpleo(html),\n          coverLetter: generarCoverLetter(plantillaDocs, job.empresa, job.puesto)\n        }\n      });\n    });\n  }\n}\n\nreturn resultados.length > 0 ? resultados : [{ json: { mensaje: \"Sin ofertas encontradas en la ejecución\" } }];"
