@use './variables' as v;
@use './tools' as t;

// Base visual compartida por las acciones interactivas del portfolio.
.heroeActions a,
.project-card__actions a,
.galeria__navBtn,
.gfLightbox__btn,
.practicasModalTrigger,
.contactSubmitRow button {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-height: 34px;
	padding: 6px 10px;
	border: 1px solid color-mix(in srgb, var(--colorBorde) 75%, transparent);
	background-color: transparent;
	color: var(--_texto);
	cursor: pointer;
	font-family: v.$fuenteTexto;
	font-size: t.fluido(0.78rem, 0.95rem);
	line-height: 1.2;
	text-decoration: none;
	transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;

	&:hover {
		background-color: var(--colorBorde);
		color: var(--_fondoPanel);
	}

	&:active {
		transform: translateY(1px);
	}

	&:focus-visible {
		outline: 2px solid var(--_texto);
		outline-offset: 2px;
	}
}

.galeria__nav {
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 8px;
