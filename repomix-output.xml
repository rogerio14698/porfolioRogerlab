ESIONAL ----------\nconst nombre_completo = lines[0] ? lines[0].replace(/[^\\w\\sÁÉÍÓÚáéíóúÑñ-]/gi, \"\").trim() : \"\";\n\nlet titulo_profesional = lines[1] || \"\";\nif (titulo_profesional.includes(\"|\")) {\n  titulo_profesional = titulo_profesional.split(\"|\")[0].trim();\n}\n\n// ---------- 4. IDIOMAS ----------\nconst idiomasArr = [];\nconst idiomaRegex = /([A-ZÁÉÍÓÚÑ][a-záéíóúñ]+(?:\\s*\\|\\s*[A-ZÁÉÍÓÚÑ][a-záéíóúñ]+)*)\\s*:\\s*([^\\n]+)/g;\nlet m;\nconst idiomasConocidos = [\"Español\", \"Spanish\", \"Portugués\", \"Portuguese\", \"Inglés\", \"English\", \"Francés\", \"French\"];\nwhile ((m = idiomaRegex.exec(text)) !== null) {\n  const clave = m[1];\n  if (idiomasConocidos.some(idi => clave.includes(idi))) {\n    clave.split(\"|\").forEach(idioma => {\n      idiomasArr.push(`${idioma.trim()}: ${m[2].trim()}`);\n    });\n  }\n}\nconst idiomasStr = idiomasArr.join(\" | \");\n\n// ---------- 5. HABILIDADES TÉCNICAS ----------\nconst skillsDict = {\n  lenguajes_programacion: [\"JavaScript\", \"TypeScript\", \"PHP\", \"Java\", \"Python\", \"C#\", \"C++\", \"Ruby\", \"Go\", \"Swift\", \"Kotlin\"],\n  frameworks_librerias: [\"Laravel\", \"Eloquent ORM\", \"Bootstrap\", \"Vanilla JS\", \"React\", \"Vue\", \"Angular\", \"Django\", \"Node\", \"NodeJS\", \"Express\"],\n  bases_datos: [\"MySQL\", \"MariaDB\", \"SQL Server\", \"Microsoft SQL Server\", \"PostgreSQL\", \"MongoDB\", \"Oracle\", \"SQLite\"],\n  devops_herramientas: [\"Git\", \"GitHub\", \"Docker\", \"Postman\", \"Nginx\", \"Apache\", \"Jenkins\", \"CI/CD\", \"Kubernetes\"],\n  cloud: [\"AWS\", \"EC2\", \"Google Cloud\", \"Azure\", \"Firebase\"],\n  otras_herramientas: [\"HTML5\", \"CSS3\", \"Sass\", \"SQL\", \"PL/SQL\", \"XML\", \"Linux\", \"Windows\"]\n};\n\nconst habilidades_tecnicas = [];\nfor (const categoria in skillsDict) {\n  const detectadas = skillsDict[categoria].filter(skill =>\n    new RegExp(`\\\\b${skill.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\")}\\\\b`, \"i\").test(text)\n  );\n  if (detectadas.length > 0) {\n    habilidades_tecnicas.push(...detectadas);\n  }\n}\nconst habilidadesStr = [...new Set(habilidades_tecnicas)].join(\", \");\n\n// ---------- 6. EXPERIENCIA ----------\nconst experienciaArr = [];\nconst fechaRangoRegex = /([A-Za-zÁÉÍÓÚñ]+\\s\\d{4})\\s*[-–]\\s*([A-Za-zÁÉÍÓÚñ]+\\s\\d{4})/g;\nlet fm;\nwhile ((fm = fechaRangoRegex.exec(text)) !== null) {\n  const idx = fm.index;\n  const antes = text.substring(0, idx).split(\"\\n\").filter(l => l.trim()).pop();\n  const puesto = antes ? antes.split(\"|\")[0].trim() : \"\";\n  const empresa = antes && antes.includes(\"|\") ? antes.split(\"|\")[1]?.trim() : \"\";\n  experienciaArr.push(`${puesto} en ${empresa} (${fm[1]} - ${fm[2]})`);\n}\nconst experienciaStr = experienciaArr.join(\"\\n\");\n\n// ---------- 7. FORMACIÓN ----------\nlet educacionStr = \"\";\nconst formacionIdx = text.search(/Formaci[oó]n|Education/i);\nif (formacionIdx !== -1) {\n  const bloqueFormacion = text.substring(formacionIdx, formacionIdx + 500);\n  const tituloEdu = bloqueFormacion.match(/Grado Superior[^\\n]*|Higher Technical Degree[^\\n]*/i);\n  const fechaEdu = bloqueFormacion.match(/(\\d{4})\\s*-\\s*(\\d{4})/);\n  if (tituloEdu) {\n    educacionStr = `${tituloEdu[0].trim()} (${fechaEdu ? fechaEdu[0] : \"\"})`;\n  }\n}\n\n// ---------- 8. RESUMEN ----------\nconst resumen_perfil = lines.slice(2, 6).join(\" \").length > 50\n  ? lines.slice(2, 6).join(\" \").replace(/\\s+/g, \" \").trim()\n  : \"\";\n\n// ---------- ESTRUCTURA PLANIFICADA PARA GOOGLE SHEETS ----------\nreturn {\n  json: {\n    fuente_archivo: tituloArchivo,\n    titulo_profesional,\n    ubicacion,\n    proyecto: proyectoLink,\n    resumen_perfil,\n    experiencia: experienciaStr,\n    idiomas: idiomasStr,\n    habilidades_tecnicas: habilidadesStr\n  }\n};"
