            text-decoration: underline;
            padding-inline: var(--space-6);
        }
    }

    .heroAvailability {
        margin-top: var(--space-8);
        max-width: 52ch;
        font-size: var(--text-small);
        color: var(--text-secondary);
    }
}

.contributions, .profileBiography {
    display: grid;
    gap: var(--space-8);
    h2 { font-size: var(--text-heading); }
}

.contributions {
    &__list { display: grid; gap: var(--space-8); }
    .contribution {
        display: grid;
        gap: var(--space-4);
        h3 { font-size: var(--text-lead); }
        p { max-width: 65ch; }
    }
    a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; }
    .contribution a { margin-top: var(--space-2); color: var(--text-secondary); }
    .contribution__projects {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 16rem));
        gap: var(--space-4);
        margin-top: var(--space-4);
        list-style: none;
        padding: 0;
        li { min-width: 0; }
    }
    .contribution .contribution__project {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: var(--space-2);
        margin-top: 0;
        height: 100%;
        overflow-wrap: anywhere;
        img { width: 100%; aspect-ratio: 8 / 5; height: auto; object-fit: contain; background: var(--surface-raised); }
    }
    a:hover { color: var(--accent); }
    &__contact { justify-self: start; }
}

.profileTools {
    display: grid;
    gap: var(--space-6);
    h2 { font-size: var(--text-heading); }
    ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--space-4) var(--space-8); }
}

.researchNote {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-8);
    background: var(--surface-raised);
    h2 { font-size: var(--text-heading); }
    p { max-width: 65ch; }
    a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        margin-top: var(--space-3);
        text-decoration: underline;
        &:hover { color: var(--accent); }
    }
}

.textoAbout {
    display: grid;
    gap: var(--space-6);
    p { max-width: 65ch; white-space: pre-line; }
}

.seccionAboutMe {
    display: grid;
    gap: var(--space-12);

    > h1 { font-size: var(--text-display); }

    .conocimientos {
        display: grid;
        gap: var(--space-8);
    }

    .conocimientosSeccione {
        display: grid;
        align-content: start;
        gap: var(--space-6);
        padding-block: var(--space-6);

        h2 { font-size: var(--text-heading); }
        ul { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); }
        li { font-size: var(--text-body); }
    }
}

.aboutNarrative {
    display: grid;
    gap: var(--space-12);

    h2 { font-size: var(--text-heading); margin-bottom: var(--space-6); }
    p { max-width: 65ch; }
    p + p { margin-top: var(--space-4); }
}

@media (min-width: 48rem) {
    .hero {
        .heroMedia { grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.8fr); gap: var(--space-12); }
        .heroFoto { height: auto; min-height: 0; max-width: 336px; justify-self: end; }
        .heroMedia--without-photo { grid-template-columns: 1fr; .heroCopy { max-width: 65ch; } }
    }
    .contributions .contribution { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--space-12); }
    .researchNote { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
    .textoAbout { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-12); }
    .seccionAboutMe .conocimientos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .aboutNarrative { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .aboutNarrative--single { grid-template-columns: 1fr; }
}

@media (max-width: 47.999rem) {
    .hero .heroFoto { max-height: 280px; aspect-ratio: 5 / 4; object-position: center 44%; }
    .researchNote { padding: var(--space-6); }
}

@media (min-width: 80rem) {
    .seccionAboutMe .conocimientos { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
</file>

