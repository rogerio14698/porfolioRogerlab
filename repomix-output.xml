         aspect-ratio: 16 / 10;\n                    img { object-fit: contain; }\n                }\n            }\n\n            &__nav { grid-column: 1 / -1; }\n        }\n    }\n}\n\n.gfLightbox {\n    position: fixed;\n    inset: 0;\n    z-index: 1600;\n    display: grid;\n    place-items: center;\n    padding: var(--space-4);\n    background: rgb(0 0 0 / 85%);\n    &[hidden] { display: none; }\n}\n\n.gfLightbox__backdrop { position: absolute; inset: 0; border: 0; background: transparent; }\n\n.gfLightbox__panel {\n    position: relative;\n    display: grid;\n    grid-template-rows: minmax(0, 1fr) auto;\n    gap: var(--space-4);\n    width: min(1120px, 100%);\n    height: min(85dvh, 800px);\n    padding: var(--space-4);\n    background: var(--surface-raised);\n    box-shadow: var(--shadow-dialog);\n}\n\n.gfLightbox__img { width: 100%; height: 100%; object-fit: contain; }\n.gfLightbox__controls { display: flex; justify-content: center; gap: var(--space-2); }\n.alinearButton { display: flex; flex-wrap: wrap; gap: var(--space-3); }\n\n@media (min-width: 64rem) {\n    .seccionProjects {\n        gap: var(--space-16);\n\n        .project-card {\n            grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);\n            column-gap: var(--space-12);\n            padding-block: var(--space-8);\n            .project-card__media { grid-column: 1; grid-row: 1; }\n            .project-card__body { grid-column: 2; grid-row: 1 / 3; }\n            .galeria { grid-column: 1; grid-row: 2; align-self: start; }\n            .galeria__nav { grid-column: 1; grid-row: 3; }\n            &:not(:has(.galeria)) .project-card__body { grid-row: 1; }\n        }\n    }\n}\n\n@media (prefers-reduced-motion: reduce) {\n    .seccionProjects .project-card .galeria__item img { transition: none; }\n    .seccionProjects .project-card .galeria__item:hover img,\n    .seccionProjects .project-card .galeria__item:focus-visible img { transform: none; }\n}\n",".portfolio-heading {\r\n    display: grid;\r\n    gap: var(--space-6);\r\n    h1 { font-size: var(--text-display); }\r\n    p { max-width: 65ch; font-size: var(--text-lead); }\r\n}\r\n\r\n.seccionProjects .project-card {\r\n    .project-card__media--capture img { padding: 0; max-height: none; }\r\n    h1 { font-size: var(--text-heading); overflow-wrap: anywhere; }\r\n    h2 a:hover { text-decoration: underline; }\r\n    .description p { white-space: pre-line; overflow-wrap: anywhere; }\r\n    .project-card__actions a { min-height: 44px; }\r\n}\r\n\r\n.project-detail .project-card {\r\n    .project-detail__heading {\r\n        grid-column: 1 / -1;\r\n        display: grid;\r\n        gap: var(--space-4);\r\n        margin-bottom: var(--space-6);\r\n        h1 { font-size: var(--text-display); max-width: 28ch; }\r\n        p { color: var(--text-secondary); }\r\n    }\r\n}\r\n\r\n@media (min-width: 64rem) {\r\n    .project-detail .project-card {\r\n        .project-card__media { grid-row: 2; }\r\n        .project-card__body, &:not(:has(.galeria)) .project-card__body { grid-row: 2 / 4; }\r\n        .galeria { grid-row: 3; }\r\n    }\r\n}\r\n\r\n.discovery {\r\n    position: relative;\r\n    min-width: 0;\r\n\r\n    &__navigation {\r\n        display: flex;\r\n        align-items: center;\r\n        gap: var(--space-2);\r\n        padding: var(--space-2) var(--space-4);\r\n        background: var(--surface-raised);\r\n        &[hidden] { display: none; }\r\n    }\r\n    &__indicators {\r\n        display: flex;\r\n        flex: 1;\r\n        flex-wrap: wrap;\r\n        justify-content: center;\r\n        gap: var(--space-2);\r\n        min-width: 0;\r\n    }\r\n    &__indicator {\r\n        display: grid;\r\n        place-items: center;\r\n        width: 44px;\r\n        height: 44px;\r\n        padding: 0;\r\n        border: 0;\r\n        background: transparent;\r\n        color: var(--text-primary);\r\n        span {\r\n            width: 12px;\r\n            height: 12px;\r\n            border: 1px solid currentColor;\r\n            border-radius: 999px;\r\n            transition: width var(--duration-fast) var(--ease-out), background var(--duration-fast);\r\n        }\r\n        &[aria-current=\"true\"] span { width: 32px; background: var(--text-primary); }\r\n        &:hover span { background: var(--text-primary); }\r\n    }\r\n    &__playback {\r\n        flex: 0 0 44px;\r\n        display: grid;\r\n        place-items: center;\r\n        width: 44px;\r\n        height: 44px;\r\n        padding: var(--space-3);\r\n        border: 0;\r\n        background: var(--action-bg);\r\n        color: var(--action-text);\r\n        cursor: pointer;\r\n        transition: background var(--duration-fast), transform var(--duration-fast);\r\n        &[hidden] { display: none; }\r\n        svg { width: 20px; height: 20px; }\r\n        &:hover:not(:disabled) { transform: scale(1.08); }\r\n        &:active:not(:disabled) { transform: scale(0.96); }\r\n        .discovery__pause-icon { display: none; }\r\n    }\r\n    &[data-playing=\"true\"] .discovery__playback {\r\n        .discovery__pause-icon { display: block; }\r\n        .discovery__play-icon { display: none; }\r\n    }\r\n    &__track {\r\n        position: relative;\r\n        display: flex;\r\n        min-width: 0;\r\n        overflow-x: auto;\r\n        overscroll-behavior-x: contain;\r\n        scroll-snap-type: x mandatory;\r\n        scrollbar-width: none;\r\n        &::-webkit-scrollbar { display: none; }\r\n        &:focus-visible { outline-offset: 4px; }\r\n    }\r\n    &__slide {\r\n        display: grid;\r\n        flex: 0 0 100%;\r\n        min-width: 0;\r\n        scroll-snap-align: start;\r\n        scroll-snap-stop: always;\r\n        background: var(--surface-raised);\r\n    }\r\n    &__image {\r\n        display: block;\r\n        min-width: 0;\r\n        overflow: hidden;\r\n        background: var(--surface-media);\r\n        align-self: start;\r\n        img { width: 100%; aspect-ratio: 16 / 10; object-fit: contain; }\r\n    }\r\n    &__copy {\r\n        display: grid;\r\n        align-content: center;\r\n        gap: var(--space-4);\r\n        min-width: 0;\r\n        padding: var(--space-6);\r\n        h2 { font-size: var(--text-heading); overflow-wrap: anywhere; max-width: 24ch; }\r\n        p { max-width: 60ch; overflow-wrap: anywhere; }\r\n    }\r\n    &__type, &__stack { font-size: var(--text-small); color: var(--text-secondary); }\r\n    &__link {\r\n        display: inline-flex;\r\n        align-items: center;\r\n        justify-self: start;\r\n        min-height: 44px;\r\n        padding: var(--space-3) var(--space-6);\r\n        margin-top: var(--space-2);\r\n        background: var(--action-bg);\r\n        color: var(--action-text);\r\n    }\r\n    a:hover { text-decoration: underline; }\r\n}\r\n\r\n@media (min-width: 64rem) {\r\n    .discovery__slide { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; }\r\n    .discovery__copy { padding: var(--space-8); }\r\n    .discovery__image { align-self: center; }\r\n}\r\n\r\n@media (min-width: 80rem) {\r\n    .discovery__copy { padding: var(--space-12); }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n    .discovery__playback { transition: none; }\r\n    .discovery__indicator span { transition: none; }\r\n    .discovery__playback:active { transform: none; }\r\n}\r\n","@use '../global/variables' as v;\n@use '../global/tools' as t;\n\n\n\n//Section games \n.sectionGames {\n    display: flex;\n    flex-direction: column;\n    justify-content: flex-start;\n    align-items: center;\n    width: 100%;\n    padding: 12px;\n    gap: 24px;\n    .cardJuegos{\n        display: flex;\n        flex-direction: column;\n        justify-content: center;\n        align-items: center;\n        width: 50%;\n        gap: 10px;\n        border: 1px solid var(--colorBorde);\n        box-shadow: 0 0 10px rgba(248, 248, 248, 0.836);\n        .logoJuego{\n            display: flex;\n            flex-direction: column-reverse;\n            justify-content: center;\n            align-items: center;\n            gap: 10px;\n            h2{\n                align-self: end;\n                font-size: t.fluido(1.5rem, 2rem);\n                font-family: v.$fuenteTexto;\n                font-weight: v.$grosorTitulo;\n                color: var(--_texto);\n                text-decoration: underline double var(--colorBorde);\n            }\n            img{\n                border: 3px solid var(--colorBorde);\n                width: 100px;\n                height: auto;\n            }\n        }\n        .descripcionJuego{\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            gap: 10px;\n            p{\n                font-size: t.fluido(0.8rem, 1rem);\n                font-family: v.$fuenteTexto;\n                color: var(--_textoSoft);\n                line-height: 1.8;\n                padding: 6px 8px;\n                text-align: justify;\n                &::first-letter {\n                    font-size: 130%;\n                }\n            }\n            a{\n                display: inline-flex;\n                align-items: center;\n                justify-content: center;\n                font-size: v.$tamanoEnlaces;\n                font-family: v.$fuenteTexto;\n                padding: 6px 10px;\n                cursor: pointer;\n                border: 1px solid var(--colorBorde);\n                background-color: transparent;\n                color: var(--_texto);\n                transition:\n                    background-color 0.3s ease,\n                    color 0.3s ease;\n                width: auto;\n                min-width: 44px;\n                margin: 5px;\n            }\n        }\n    }\n}\n\n.gamesScrollHint {\n    display: none;\n}\n@media (max-width: 768px) {\n    .gamesScrollHint {\n        display: block;\n        text-align: center;\n        font-size: .8rem;\n        font-family: v.$fuenteTexto;\n        color: var(--_texto);\n        margin-top: 1rem;\n        padding: 1rem;\n        border: 1px solid var(--colorBorde);\n        background: var(--_fondoPanel);\n        \n    }\n    .gamesScrollHint::before {\n        content: \"\";\n        position: absolute;\n        top: 0;\n        left: 0;\n        width: 100%;\n        height: 100%;\n        background: var(--_fondo);\n        z-index: -1;\n    }\n}","// --- Colores Fondo ---\n$colorModoDarkFondo: #101715;\n$colorModoLightFondo: #f4f7f5;\n\n// --- Fondos de panel ---\n$colorFondoPanelDark: rgba(34, 34, 34, .9);\n$colorFondoPanelLight: hsla(0, 0%, 100%, .88);\n\n// --- Líneas ---\n$colorLineaLight: #999;\n$colorLineaDark: #fff;\n\n// --- Botones ---\n$colorbtnDark: #19221d;\n$colorbtnLight: #fff;\n$btnLight: #999;\n$btnDark: #222;\n\n// --- Textos y Bordes ---\n$colorTextoLight: #e7eee9;\n$colorTextoDark: #18251e;\n$colorBorde: #82998c;\n$colorBordeLight: #51695b;\n$opacidadScrollbar: 45%;\n$opacidadScrollbarHover: $opacidadScrollbar + 20%;\n\n// --- Tamaños ---\n$anchoContenedor: 90%;\n\n// En Sass puedes usar variables dentro de otras variables directamente\n$borde: 2px solid $colorBorde; \n\n// --- Fuentes (Tipografía) ---\n// Nota: Corregido el 'sans-serif3' que tenías por 'sans-serif'\n$fuenteTitulo: 'JetBrains Mono', monospace;\n$grosorTitulo: 600;\n$estiloTitulo: normal;\n\n$fuenteTexto: 'Public Sans', sans-serif;\n$grosorTexto: 400;\n$estiloTexto: normal;\n\n// --- Media Queries: Tamaños (1370px) ---\n$tamanoTituloDesktopXL: 2.6rem;\n$tamanoEnlacesDesktopXL: 1.2rem;\n$tamanoTextoDesktopXL: 1rem;\n\n// --- Tamaños Base ---\n$tamanoTitulo: $tamanoTituloDesktopXL;\n$tamanoEnlaces: $tamanoEnlacesDesktopXL;\n$tamanoTexto: $tamanoTextoDesktopXL;\n\n// --- Media Queries: Tamaños (576px) ---\n$tamanoTituloMovileXS: 2rem;\n$tamanoTextoMovileXS: 0.9rem;\n$tamanoEnlaceMovileXS: 0.9rem;\n\n// --- Media Queries: Tamaños (768px) ---\n$tamanoTitulotoMovil: 2.2rem;\n$tamanoTextoMovil: 1.1rem; ",".seccionContact {\n    display: grid;\n    gap: var(--space-8);\n    align-items: start;\n\n    h1 { font-size: var(--text-display); }\n    .contactIntro {\n        display: grid;\n        gap: var(--space-6);\n        p { max-width: 42ch; }\n    }\n    .contactPaths {\n        display: grid;\n        justify-items: start;\n        gap: var(--space-3);\n        margin-top: var(--space-4);\n        &[hidden] { display: none; }\n        button {\n            min-height: 48px;\n            padding: var(--space-3) var(--space-4);\n            border: 0;\n            background: var(--surface-raised);\n            color: var(--text-primary);\n            text-align: left;\n            &:hover { color: var(--accent); text-decoration: underline; }\n            &:active { background: var(--action-bg); color: var(--action-text); }\n        }\n    }\n    form { display: grid; gap: var(--space-8); min-width: 0; }\n\n    .contactFormGrid { display: grid; gap: var(--space-6); }\n\n    .formLabel {\n        display: grid;\n        gap: var(--space-2);\n        align-content: start;\n        min-width: 0;\n\n        label { font-size: var(--text-body); font-weight: 600; }\n        input, textarea {\n            width: 100%;\n            min-width: 0;\n            min-height: 52px;\n            padding: var(--space-4);\n            border: 1px solid var(--field-border);\n            border-radius: var(--radius-control);\n            background: var(--input-bg);\n            color: var(--text-primary);\n            line-height: 1.5;\n            transition: background var(--duration-fast), border-color var(--duration-fast);\n\n            &::placeholder { color: var(--text-secondary); opacity: 1; }\n            &:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 4px; }\n            &[aria-invalid=\"true\"] { border-width: 2px; }\n        }\n\n        textarea { min-height: 180px; resize: vertical; }\n    }\n\n    .contactFormMeta, .contactAlert {\n        padding: var(--space-6);\n        background: var(--surface-raised);\n        p { font-size: var(--text-body); max-width: 65ch; }\n    }\n\n    .contactAlert--error { font-weight: 600; }\n    .contactTurnstile { min-height: 65px; max-width: 100%; }\n    .contactSubmitRow { display: flex; }\n    .contactSubmitRow button { min-width: min(240px, 100%); }\n}\n\n@media (min-width: 48rem) {\n    .seccionContact {\n        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);\n        gap: var(--space-12);\n    }\n}\n\n@media (min-width: 64rem) {\n    .seccionContact {\n        .contactFormGrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n        .formLabel:nth-child(n + 3) { grid-column: 1 / -1; }\n    }\n}\n"]}
