.gfLightbox__btn {
	min-width: 40px;
}

.practicasModalTrigger {
	min-height: 36px;
	padding: 6px 12px;
}

.contactSubmitRow button {
	min-width: min(260px, 100%);
	padding: 10px 16px;
	font-size: v.$tamanoEnlaces;
}

